# Copy to .env (never commit .env): cp .env.example .env

# --- The Family Hub (on the Chromebook) ---
HUB_URL=http://192.168.1.208:8770
# On the Chromebook: cd AIFAMINTERFACE && python3 -m hub agent token trader
HUB_TOKEN=
# TRADER_HUB=0 keeps the token (for cloud budgets) but turns the hub connection off

# --- Brains ---
# The boss's "AI family" key. The monthly budget is set in the hub (Admin → Cloud AI budgets), not here.
ANTHROPIC_API_KEY=
LOCAL_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434

# --- Money mode ---
# paper = pretend money at real prices (start here). live = real money; every trade waits for the boss's 👍.
TRADER_MODE=paper
TRADER_PAPER_EQUITY=1000

# --- Hyperliquid (see docs/HYPERLIQUID_SETUP.md) ---
# The account Trader trades for (best: a sub-account just for him, funded with what he may trade)
HL_ACCOUNT_ADDRESS=
# If that's a sub-account: your main address (where API wallets are approved)
HL_MASTER_ADDRESS=
# Trader's API wallet key — written here by `trader wallet new`. It can trade, never withdraw.
HL_AGENT_PRIVATE_KEY=
# Stock markets to trade (HIP-3): xyz = trade.xyz, mkts / km = Markets by Kinetiq, cash, flx
TRADER_DEXES=xyz,mkts,km,cash,flx
# Blank = every liquid stock & index. Or a list: NVDA,TSLA,AAPL,mkts:US500
TRADER_WATCHLIST=
TRADER_MIN_DAY_VOLUME_USD=5000000
TRADER_MAX_SYMBOLS=25
TRADER_STOCKS_ONLY=1

# --- The boss's rules ---
TRADER_HARD_STOP_PCT=10
TRADER_MIN_TRADES_WEEK=2
TRADER_PRIORITY=inside
TRADER_MIN_RR=1.5

# --- Sizing ---
TRADER_LEVERAGE=1
TRADER_RISK_PER_TRADE_PCT=2
TRADER_MAX_POSITION_PCT=30
TRADER_MAX_OPEN=3
# Fee per side in % (HIP-3 stock markets cost more than crypto; 0.09 is a safe assumption)
TRADER_FEE_PCT=0.09

# --- Take profit & trailing stop ---
# r = measured in the setup's own risk (R). Switch on at +1.5R, follow 1R behind (locks +0.5R at once).
TRADER_TRAIL_MODE=r
TRADER_TRAIL_ACTIVATE_R=1.5
TRADER_TRAIL_R=1.0

# --- When Trader looks for entries (New York time, weekdays) ---
TRADER_WINDOW_START=09:45
TRADER_WINDOW_END=15:45
TRADER_SCAN_MINUTES=15
TRADER_REPORT_TIME=16:30

# --- His dashboard (http://localhost:8767) ---
TRADER_DASH=1
TRADER_DASH_PORT=8767
# This Mac only. For your phone on the home Wi-Fi: TRADER_DASH_HOST=0.0.0.0 plus a long TRADER_DASH_KEY
TRADER_DASH_HOST=127.0.0.1
TRADER_DASH_KEY=

# --- The Strat documents (drop PDFs, Word docs, notes here; docs/strat/ is always read too) ---
TRADER_STRAT_DOCS_DIR=~/Documents/Trader Strat Docs
TRADER_OWNER_NAME=Modd
